{
  "model": "SAFE",
  "text_encoder": "BERT-base (frozen)",
  "image_encoder": "ResNet-50 (frozen)",
  "text_dim": 768,
  "image_dim": 2048,
  "proj_dim": 512,
  "fusion": "concatenation + cosine similarity",
  "num_classes": 2,
  "metadata_used": true,
  "metadata_dim": 5,
  "dropout": 0.3,
  "classifier_dropout": 0.4,
  "optimizer": "AdamW",
  "lr": 0.0001,
  "weight_decay": 0.0001,
  "scheduler": "CosineAnnealingLR",
  "T_max": 20,
  "gradient_clipping": 1.0,
  "batch_size": 16,
  "max_epochs": 100,
  "actual_epochs": 11,
  "early_stopping_patience": 10,
  "dataset": "M4FC",
  "split": "70/15/15",
  "seed": 42,
  "reference": "Zhou et al., 2020 (SAFE)"
}